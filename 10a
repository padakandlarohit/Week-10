### `test/widget_test.dart`

dart
```

import 'package:flutter_test/flutter_test.dart';
import 'package:counter_lab/main.dart';
import 'package:flutter/material.dart';

void main() {
  group('Counter Application Tests', () {
    testWidgets('Initial counter value is zero', (tester) async {
      await tester.pumpWidget(const MyApp());

      expect(find.text('0'), findsOneWidget);
    });

    testWidgets('Counter increments when button is tapped',
        (tester) async {
      await tester.pumpWidget(const MyApp());

      await tester.tap(
        find.byKey(const ValueKey('incrementButton')),
      );
      await tester.pump();

      expect(find.text('1'), findsOneWidget);
    });

    testWidgets('Counter decrements when button is tapped',
        (tester) async {
      await tester.pumpWidget(const MyApp());

      await tester.tap(
        find.byKey(const ValueKey('incrementButton')),
      );
      await tester.pump();

      await tester.tap(
        find.byKey(const ValueKey('incrementButton')),
      );
      await tester.pump();

      await tester.tap(
        find.byKey(const ValueKey('decrementButton')),
      );
      await tester.pump();

      expect(find.text('1'), findsOneWidget);
    });

    testWidgets('Counter never goes below zero', (tester) async {
      await tester.pumpWidget(const MyApp());

      await tester.tap(
        find.byKey(const ValueKey('decrementButton')),
      );
      await tester.pump();

      expect(find.text('0'), findsOneWidget);
    });

    testWidgets('Counter text displays correctly at 10',
        (tester) async {
      await tester.pumpWidget(const MyApp());

      for (int i = 0; i < 10; i++) {
        await tester.tap(
          find.byKey(const ValueKey('incrementButton')),
        );
        await tester.pump();
      }

      expect(find.text('10'), findsOneWidget);
      expect(tester.takeException(), isNull);
    });
  });
}
